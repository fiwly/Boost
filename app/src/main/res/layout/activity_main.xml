<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout android:orientation="vertical" android:padding="20dp"
        android:layout_width="match_parent" android:layout_height="wrap_content">

        <TextView android:text="ANIIMO BOOST" android:textSize="28sp" android:textStyle="bold"
            android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <TextView android:text="Performance control • No root" android:textSize="14sp"
            android:alpha="0.7" android:paddingBottom="16dp"
            android:layout_width="match_parent" android:layout_height="wrap_content"/>

        <TextView android:id="@+id/status" android:text="Checking device..." android:padding="14dp"
            android:background="#EFEFEF" android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <Button android:id="@+id/refresh" android:text="Refresh Status"
            android:layout_width="match_parent" android:layout_height="wrap_content"/>

        <TextView android:text="QUICK PROFILES" android:textStyle="bold" android:textSize="14sp"
            android:paddingTop="18dp" android:paddingBottom="6dp"
            android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <Button android:id="@+id/max" android:text="MAX FPS • 60 / 0.70x"
            android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <Button android:id="@+id/balanced" android:text="BALANCED • 60 / 0.75x"
            android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <Button android:id="@+id/cooler" android:text="COOLER • 45 / 0.80x"
            android:layout_width="match_parent" android:layout_height="wrap_content"/>

        <TextView android:text="CUSTOM PROFILE" android:textStyle="bold" android:textSize="14sp"
            android:paddingTop="18dp" android:paddingBottom="6dp"
            android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <TextView android:text="Render scale" android:textStyle="bold"
            android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <Spinner android:id="@+id/scale" android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <TextView android:text="FPS target" android:textStyle="bold" android:paddingTop="10dp"
            android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <Spinner android:id="@+id/fps" android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <Button android:id="@+id/apply" android:text="APPLY CUSTOM PROFILE"
            android:layout_width="match_parent" android:layout_height="wrap_content"/>

        <Button android:id="@+id/performance" android:text="Set Performance Mode"
            android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <Button android:id="@+id/standard" android:text="RESTORE ANIIMO DEFAULT"
            android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <Button android:id="@+id/launch" android:text="LAUNCH ANIIMO"
            android:layout_width="match_parent" android:layout_height="wrap_content"/>

        <TextView android:id="@+id/thermal" android:text="Thermal: -" android:textStyle="bold"
            android:paddingTop="18dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <TextView android:id="@+id/result" android:text="Ready." android:paddingTop="12dp"
            android:paddingBottom="20dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
    </LinearLayout>
</ScrollView>